DB_HOST=localhost
DB_PORT=5432
DB_NAME=itemsplit
DB_USER=itemsplit
DB_PASSWORD=itemsplit
DB_URL=jdbc:postgresql://localhost:5432/itemsplit
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRATION=86400000
LOCAL_STORAGE_ROOT=./storage
STORAGE_TYPE=local
S3_BUCKET=
AWS_REGION=ap-northeast-2
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=120
RATE_LIMIT_WINDOW_SECONDS=60
APP_PORT=8080
FRONTEND_PORT=3000

# Use local,ocr after setting the real receipt API credentials below.
SPRING_PROFILES_ACTIVE=local
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET=
OCR_CONNECT_TIMEOUT=3s
OCR_READ_TIMEOUT=15s
OCR_PER_RECEIPT_DAILY_LIMIT=15
OCR_PER_USER_DAILY_LIMIT=60

# Optional: >=32-byte key for local image URLs, separate from JWT_SECRET.
# Empty generates a random key at startup; existing URLs then expire on restart.
LOCAL_STORAGE_SIGNING_SECRET=
