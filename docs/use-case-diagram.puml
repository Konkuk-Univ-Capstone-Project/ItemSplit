@startuml ItemSplitUseCase
left to right direction

skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
  ArrowColor #334155
}
skinparam actor {
  BorderColor #334155
  FontColor #0F172A
}

actor "서비스 사용자" as User
actor "방 멤버" as Member
actor "방장" as Owner
actor "초대받은 사용자" as Invitee
actor "공유 링크 조회자" as SharedViewer

Member --|> User
Owner --|> Member
Invitee --|> User

rectangle "ItemSplit 웹서비스" {
  package "인증" {
    usecase "회원가입" as UC_Signup
    usecase "로그인" as UC_Login
    usecase "내 정보 조회" as UC_Me
  }

  package "방/멤버 관리" {
    usecase "방 생성" as UC_CreateRoom
    usecase "방 삭제" as UC_DeleteRoom
    usecase "방 멤버 조회" as UC_ViewMembers
    usecase "수동 멤버 추가" as UC_AddManualMember
    usecase "멤버 이름 수정" as UC_UpdateMember
    usecase "멤버 제외/방 나가기" as UC_DeleteMember
    usecase "초대 토큰 발급" as UC_IssueInvite
    usecase "참여 옵션 조회" as UC_JoinOptions
    usecase "초대 토큰으로 참여" as UC_JoinRoom
    usecase "수동 멤버와 계정 매칭" as UC_ClaimManualMember
  }

  package "영수증/품목 관리" {
    usecase "영수증 목록/상세 조회" as UC_ViewReceipts
    usecase "이미지 영수증 업로드" as UC_UploadReceipt
    usecase "수동 영수증 생성" as UC_CreateManualReceipt
    usecase "영수증 수정/삭제" as UC_EditReceipt
    usecase "품목 추가/수정/삭제" as UC_ManageItems
    usecase "품목별 참여자 지정" as UC_AssignItemMembers
  }

  package "정산/공유" {
    usecase "정산 결과 조회" as UC_ViewSettlement
    usecase "송금 흐름 확인" as UC_ViewTransfers
    usecase "읽기 전용 공유 토큰 발급" as UC_IssueShare
    usecase "공유 정산 조회" as UC_ViewSharedSettlement
  }
}

User --> UC_Signup
User --> UC_Login
User --> UC_Me
User --> UC_CreateRoom

Member --> UC_ViewMembers
Member --> UC_AddManualMember
Member --> UC_UpdateMember
Member --> UC_DeleteMember
Member --> UC_IssueInvite
Member --> UC_ViewReceipts
Member --> UC_UploadReceipt
Member --> UC_CreateManualReceipt
Member --> UC_EditReceipt
Member --> UC_ManageItems
Member --> UC_AssignItemMembers
Member --> UC_ViewSettlement
Member --> UC_ViewTransfers
Member --> UC_IssueShare

Owner --> UC_DeleteRoom

Invitee --> UC_JoinOptions
Invitee --> UC_JoinRoom

SharedViewer --> UC_ViewSharedSettlement

UC_JoinRoom ..> UC_JoinOptions : <<include>>
UC_JoinRoom ..> UC_ClaimManualMember : <<extend>>
UC_CreateManualReceipt ..> UC_ManageItems : <<include>>
UC_AssignItemMembers ..> UC_ViewMembers : <<include>>
UC_ViewSettlement ..> UC_AssignItemMembers : <<include>>
UC_ViewTransfers ..> UC_ViewSettlement : <<include>>
UC_ViewSharedSettlement ..> UC_ViewSettlement : <<include>>

@enduml
