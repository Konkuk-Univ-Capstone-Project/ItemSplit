@startuml ItemSplitSystemArchitecture
top to bottom direction
title ItemSplit System Architecture

skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam ArrowColor #334155
skinparam component {
  BackgroundColor #F8FAFC
  BorderColor #334155
}
skinparam database {
  BackgroundColor #EFF6FF
  BorderColor #1D4ED8
}
skinparam note {
  BackgroundColor #FFFBEB
  BorderColor #D97706
}

actor "사용자 / 공유 링크 조회자" as User

node "사용자 브라우저" as Browser {
  component "React 19 + TypeScript\n(Vite 빌드)\n영수증 검토 UI · 송금 대상/금액 계산" as Frontend
}

node "Docker Compose" as Compose {
  node "frontend 컨테이너 :80\n기본 호스트 포트 3000" {
    component "Nginx\n정적 파일 제공 · /api/ 프록시" as Nginx
  }

  node "app 컨테이너 :8080\nSpring Boot 3.5 / Java 21" as Backend {
    component "요청 필터\nSpring Security · JWT · Rate Limit" as Security
    component "REST Controllers\n인증 · 방/공유 · 영수증/이미지\n품목/배정 · 정산 · OCR" as Controllers

    package "서비스" {
      component "업무 서비스\nAuth / Room / Receipt / Item\nAssignment / Settlement\n방 권한 · 금액 검증" as Core
      component "OcrService / OcrDraftService\n작업 요청·조회 · 초안 저장·반영\n작성자 권한 · 버전 검사 · 중복 방지" as Ocr
      component "OcrWorker\n커밋 후 이벤트 → 스레드풀 실행\n작업·이미지 상태 / 오류 관리" as Worker
      component "ClovaReceiptOcrEngine\nHttpClovaTransport\n응답 파싱" as Engine
    }

    package "이미지 저장·조회" {
      component "StorageService\nLocalStorageService 또는 S3StorageService\n파일 저장·읽기·삭제" as Storage
      component "StorageReadUrls\n로컬 HMAC / S3 Presigned URL 발급" as ReadUrls
      component "LocalImageController\n서명·만료 검증 후 원본 응답" as LocalImage
    }

    component "Spring Data JPA / Hibernate\nRepositories · Entities\n스키마 검증 (ddl-auto=validate)\n영수증·품목·배정 / OCR 작업·초안" as Persistence
    component "Flyway\n시작 시 스키마 마이그레이션" as Flyway
  }

  database "postgres 컨테이너 :5432\nPostgreSQL 16\nitemsplit-postgres-data 볼륨" as PostgreSQL
  folder "itemsplit-storage 볼륨\n/app/storage\n로컬 이미지 · 삭제 재시도 기록" as LocalStorage
}

cloud "외부 서비스" {
  component "NAVER CLOVA OCR\nDocument 영수증 API" as Clova
  storage "AWS S3\n비공개 영수증 이미지 객체" as S3
}

User --> Frontend : 화면 조작
Frontend -left-> Nginx : 정적 파일 요청 / REST API\nJSON · multipart · JWT
Nginx --> Security : /api/ → app:8080
Security --> Controllers
Security --> LocalImage : /api/storage/local/**
Controllers --> Core
Controllers --> Ocr

Core --> Persistence
Core --> Storage : 영수증 이미지 저장·삭제
Core --> ReadUrls : 방 멤버 확인 후\n이미지 URL 발급
Ocr --> Persistence : 작업·초안 저장\n확정 품목·참여자 배정 반영
Ocr ..> Worker : AFTER_COMMIT 이벤트
Worker --> Persistence : 인식 상태·초안 저장
Worker --> Storage : ReceiptImageReader\n저장된 파일 읽기
Worker --> Engine : 이미지 바이트 전달
Engine --> Clova : HTTPS multipart\n서버 인증 키

Persistence --> PostgreSQL : JDBC
Flyway --> PostgreSQL : 버전별 SQL 적용
Storage --> LocalStorage : STORAGE_TYPE=local
Storage --> S3 : STORAGE_TYPE=s3\nAWS SDK
LocalImage --> Storage : 로컬 원본 읽기
LocalImage --> Persistence : 이미지 메타데이터 조회
Frontend ..> S3 : S3 선택 시 원본 직접 조회\n5분 Presigned GET

note bottom of ReadUrls
  서명 URL은 API 응답으로 브라우저에 전달.
  로컬: Nginx → LocalImageController 경유.
  S3: 브라우저가 비공개 객체를 서명 URL로 조회.
  두 방식 모두 유효 시간 5분.
end note

note bottom of Ocr
  OCR 시작과 이미지 업로드는 별도 요청.
  진행 상태는 브라우저가 1.5초 간격으로 조회.
  검토·저장·정산 반영은 OCR 재호출 없이 처리.
end note

legend bottom
  기본 local 프로필은 OCR 비활성. 실제 CLOVA 연동은 ocr 프로필과 서버 키 설정 필요.
  저장소는 local(기본) 또는 s3 중 선택. 개발 시 Vite :5173이 Nginx 대신 API를 프록시.
  공유 정산은 공유 토큰으로 비로그인 조회. 이미지 목록·URL 발급은 JWT와 방 멤버 권한 필요.
endlegend

@enduml
